@model List<Product>
@{ ViewData["Title"] = "Sản phẩm"; }
<div class="card"><div class="card-header"><h3 class="card-title">Danh sách sản phẩm</h3><button class="btn btn-primary btn-sm float-end" onclick="alert('Bài mẫu giao diện: chức năng thêm sẽ được bổ sung khi kết nối dữ liệu.')"><i class="fa fa-plus me-1"></i>Thêm sản phẩm</button></div><div class="card-body"><div class="row mb-3"><div class="col-md-5"><input id="searchProduct" class="form-control" placeholder="Tìm theo tên sản phẩm..." oninput="filterProducts()" /></div><div class="col-md-3"><select id="filterStatus" class="form-select" onchange="filterProducts()"><option value="">Tất cả trạng thái</option><option>Đang bán</option><option>Hết hàng</option></select></div></div><div class="table-responsive"><table class="table table-bordered table-hover align-middle" id="productsTable"><thead><tr><th>Mã</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr data-name="@p.Name.ToLower()" data-status="@p.Status"><td>@p.Id</td><td>@p.Name</td><td>@p.Category</td><td>@p.Price.ToString("N0") ₫</td><td>@p.Stock</td><td>@if(p.Stock>0){<span class="badge text-bg-success">@p.Status</span>}else{<span class="badge text-bg-danger">@p.Status</span>}</td><td><button class="btn btn-warning btn-sm" onclick="alert('Chức năng sửa là giao diện minh họa.')"><i class="fa fa-pen"></i></button> <button class="btn btn-danger btn-sm" onclick="alert('Chức năng xóa là giao diện minh họa.')"><i class="fa fa-trash"></i></button></td></tr>}</tbody></table></div></div></div>
<script>function filterProducts(){const q=document.getElementById('searchProduct').value.toLowerCase();const s=document.getElementById('filterStatus').value;document.querySelectorAll('#productsTable tbody tr').forEach(r=>r.hidden=!(r.dataset.name.includes(q)&&(!s||r.dataset.status===s)));}</script>
