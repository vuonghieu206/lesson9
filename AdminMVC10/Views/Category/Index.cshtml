@model List<Category>
@{ ViewData["Title"] = "Danh mục"; }
<div class="card"><div class="card-header"><h3 class="card-title">Danh sách danh mục</h3><button class="btn btn-primary btn-sm float-end" onclick="alert('Bài mẫu giao diện: chức năng thêm sẽ được bổ sung khi kết nối dữ liệu.')"><i class="fa fa-plus me-1"></i>Thêm danh mục</button></div><div class="card-body table-responsive"><table class="table table-bordered table-hover"><thead><tr><th style="width:90px">Mã</th><th>Tên danh mục</th><th style="width:180px">Thao tác</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Id</td><td>@c.Name</td><td><button class="btn btn-warning btn-sm" onclick="alert('Chức năng sửa là giao diện minh họa.')"><i class="fa fa-pen"></i> Sửa</button> <button class="btn btn-danger btn-sm" onclick="alert('Chức năng xóa là giao diện minh họa.')"><i class="fa fa-trash"></i> Xóa</button></td></tr>}</tbody></table></div></div>
