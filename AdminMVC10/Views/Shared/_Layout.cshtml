<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - AdminLTE MVC</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@6.5.2/css/all.min.css" />
<link rel="stylesheet" href="~/adminlte/css/adminlte.min.css" />
<link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
<nav class="app-header navbar navbar-expand bg-body">
<ul class="navbar-nav"><li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#"><i class="fa-solid fa-bars"></i></a></li><li class="nav-item d-none d-md-block"><a asp-controller="Home" asp-action="Index" class="nav-link">Trang chủ</a></li></ul>
<ul class="navbar-nav ms-auto"><li class="nav-item"><span class="nav-link"><i class="fa-regular fa-bell"></i> <span class="badge text-bg-warning">3</span></span></li><li class="nav-item"><span class="nav-link"><i class="fa-solid fa-user"></i> Admin</span></li></ul>
</nav>
<aside class="app-sidebar bg-dark" data-bs-theme="dark">
<div class="sidebar-brand"><a asp-controller="Home" asp-action="Index" class="brand-link"><img src="~/adminlte/assets/img/AdminLTELogo.png" alt="AdminLTE" class="brand-image opacity-75 shadow"/><span class="brand-text fw-light">AdminLTE MVC</span></a></div>
<div class="sidebar-wrapper"><nav class="mt-2"><ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
<li class="nav-item"><a asp-controller="Home" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-gauge-high"></i><p>Trang chính</p></a></li>
<li class="nav-header">QUẢN LÝ CỬA HÀNG</li>
<li class="nav-item"><a asp-controller="Category" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-list"></i><p>Danh mục</p></a></li>
<li class="nav-item"><a asp-controller="Product" asp-action="Index" class="nav-link"><i class="nav-icon fa-solid fa-box"></i><p>Sản phẩm</p></a></li>
<li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fa-solid fa-newspaper"></i><p>Bài viết</p></a></li>
<li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fa-regular fa-images"></i><p>Banner</p></a></li>
<li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fa-solid fa-users"></i><p>Khách hàng</p></a></li>
<li class="nav-item"><a href="#" class="nav-link"><i class="nav-icon fa-solid fa-cart-shopping"></i><p>Đơn hàng</p></a></li>
</ul></nav></div></aside>
<main class="app-main"><div class="app-content-header"><div class="container-fluid"><div class="row"><div class="col-sm-6"><h3 class="mb-0">@ViewData["Title"]</h3></div><div class="col-sm-6"><ol class="breadcrumb float-sm-end"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></div></div></div></div><div class="app-content"><div class="container-fluid">@RenderBody()</div></div></main>
<footer class="app-footer"><strong>AdminLTE MVC .NET 10</strong><span class="float-end d-none d-sm-inline">Bài thực hành ASP.NET Core MVC</span></footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/adminlte/js/adminlte.min.js"></script><script src="~/js/site.js"></script>
</body></html>
